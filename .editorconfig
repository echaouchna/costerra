root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,tf,hcl,tfvars,toml,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[justfile]
indent_size = 4

[*.tsv]
indent_style = tab
